<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PIMToolbox.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon ToolTipText="PIM Toolbox" Clicked="OnTrayShow">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show PIM Toolbox" Click="OnTrayShow" />
            <NativeMenuItem Header="Exit" Click="OnTrayExit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
